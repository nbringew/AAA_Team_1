   "source": "summary_df = pd.DataFrame(cleaning_log, columns=['Schritt', 'Entfernte Zeilen', 'Begründung'])\nsummary_df['Anteil (%)'] = (summary_df['Entfernte Zeilen'] / raw_rows * 100).round(2)\n\ntotal_removed = raw_rows - len(df)\n\nprint(f\"Rohdatensatz: {raw_rows:,} Zeilen × {raw_cols} Spalten\\n\")\nprint(summary_df[['Schritt', 'Entfernte Zeilen', 'Anteil (%)', 'Begründung']].to_string(index=False))\nprint(f\"\\nGesamt entfernt: {total_removed:,} ({total_removed/raw_rows*100:.1f} %)\")\nprint(f\"Verbleiben:      {len(df):,} Zeilen, {df.shape[1]} Spalten\")",
